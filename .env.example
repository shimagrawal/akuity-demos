# Akuity Platform
AKUITY_ORG_NAME=<your-akuity-org-name>
AKUITY_ARGOCD_INSTANCE_NAME=<your-argocd-instance>
AKUITY_KARGO_INSTANCE_NAME=<your-kargo-instance>

# Argo CD destination cluster (name as registered in Argo CD)
ARGOCD_DESTINATION=<your-cluster-name>

# This repository
GITOPS_REPO_URL=https://github.com/<your-username>/akuity-demos.git
GITHUB_USERNAME=<your-username>
# Classic PAT with: repo, write:packages
GITHUB_PAT=<your-pat>

# Where demos publish OCI artifacts (lowercase)
OCI_REPO_PREFIX=ghcr.io/<your-username>/akuity-demos
